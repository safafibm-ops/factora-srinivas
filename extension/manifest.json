{
  "manifest_version": 3,
  "name": "Factora — Student Cyber Defense Guardian",
  "version": "1.1.1",
  "description": "Protects students, job seekers, and developers from fake recruitment drives, scholarship scams, and malicious coding tests in real time.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Factora Cyber Defense Guardian"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

